{
  "workspace-confinement-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CORTEX_CONFIG_ROOT:-$HOME/.gemini/config}/hooks/workspace_confinement.py\" --allow-root \"${CORTEX_PROJECTS_ROOT:-$HOME/10_PROJECTS}\" --allow-root \"${CORTEX_CONFIG_ROOT:-$HOME/.gemini/config}\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 /Users/borjafernandezangulo/10_PROJECTS/60_SCRIPTS/workspace_pre_invocation_telemetry.py",
        "timeout": 5
      }
    ]
  }
}
